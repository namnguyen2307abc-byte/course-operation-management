        <mxCell id="e3_cash" value="Tiền mặt" edge="1" parent="lane3" source="step3_2" target="step3_cash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F39C12;strokeWidth=1;">
