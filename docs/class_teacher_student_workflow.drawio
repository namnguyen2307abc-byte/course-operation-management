<mxfile host="app.diagrams.net" modified="2026-10-13T09:15:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="WorkflowDiagram" name="Luồng Gán GV và Học Sinh Vào Lớp">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= BANNER TIÊU ĐỀ CHÍNH ================= -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;HỆ THỐNG VẬN HÀNH HỌC VIỆN TALENT ACADEMY (SWP391)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;QUY TRÌNH TẠO LỚP - GÁN GIÁO VIÊN - THÊM HỌC SINH VÀO LỚP &amp;amp; ĐIỂM DANH&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#0D233A;fontColor=#FFFFFF;shadow=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="70" as="geometry" />
        </mxCell>

        <!-- ================= SWIMLANE 1: GÁN GIÁO VIÊN & TẠO LỚP ================= -->
        <mxCell id="lane1" value="PHÂN HỆ 1: TẠO LỚP &amp;amp; GÁN GIÁO VIÊN PHỤ TRÁCH&#xa;(Role: ADMIN / GIÁO VỤ)" style="swimlane;startSize=50;fillColor=#EBF5FB;strokeColor=#2980B9;fontColor=#1B4F72;fontStyle=1;fontSize=13;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="350" height="880" as="geometry" />
        </mxCell>

        <mxCell id="step1_1" value="Admin / Giáo vụ truy cập&#xa;&lt;b&gt;weekly-schedule.html&lt;/b&gt;&#xa;Bấm &quot;Tạo Lớp Học Mới&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2980B9;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="70" width="230" height="55" as="geometry" />
        </mxCell>

        <mxCell id="step1_2" value="Nhập thông tin cơ bản:&#xa;• Mã lớp (classCode)&#xa;• Tên lớp (className)&#xa;• Khóa học (courseId) &amp;amp; Cơ sở" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2980B9;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="155" width="230" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step1_3" value="&lt;b style=&quot;color:#C0392B;&quot;&gt;★ GÁN GIÁO VIÊN PHỤ TRÁCH&lt;/b&gt;&#xa;Chọn Giáo viên từ danh sách&#xa;&lt;i&gt;gửi trường: teacherId&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;fontSize=12;fontColor=#2C3E50;shadow=1;strokeWidth=2;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="250" width="230" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step1_4" value="Cấu hình Thời khóa biểu:&#xa;• Các thứ trong tuần (VD: T2, T4, T6)&#xa;• Giờ bắt đầu, Giờ kết thúc&#xa;• Tổng số buổi học (totalSessions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2980B9;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="345" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step1_5" value="Gửi API Backend:&#xa;&lt;b&gt;POST /api/schedule/classes&lt;/b&gt;&#xa;Lưu vào bảng &lt;b&gt;classes&lt;/b&gt;&#xa;(gắn teacher_id vào ClassEntity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#27AE60;fontSize=12;fontColor=#1E8449;shadow=1;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="445" width="230" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step1_6" value="&lt;b&gt;Thuật Toán Tự Sinh Buổi Học&lt;/b&gt;&#xa;(Lesson Generator):&#xa;Sinh ra N buổi học trong bảng &lt;b&gt;lessons&lt;/b&gt;&#xa;mỗi buổi đều gắn &lt;b&gt;teacher_id&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2980B9;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="540" width="230" height="75" as="geometry" />
        </mxCell>

        <mxCell id="step1_7" value="&lt;b style=&quot;color:#27AE60;&quot;&gt;✔ LỚP HỌC MỞ THÀNH CÔNG&lt;/b&gt;&#xa;Trạng thái: &lt;b&gt;OPEN&lt;/b&gt;&#xa;Sẵn sàng tiếp nhận học viên&#xa;và hiển thị trên Lịch Tuần" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#1ABC9C;fontSize=12;fontColor=#117A65;shadow=1;strokeWidth=2;" vertex="1" parent="lane1">
          <mxGeometry x="60" y="645" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- Edges Lane 1 -->
        <mxCell id="e1_1" edge="1" parent="lane1" source="step1_1" target="step1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2980B9;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
