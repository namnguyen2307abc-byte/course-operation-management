        </mxCell>


        <!-- ================= SWIMLANE 2: TUYỂN SINH & XẾP LỚP ================= -->
        <mxCell id="lane2" value="PHÂN HỆ 2: TUYỂN SINH &amp;amp; XẾP LỚP HỌC SINH&#xa;(Role: PHỤ HUYNH &amp;amp; GIÁO VỤ)" style="swimlane;startSize=50;fillColor=#F4ECF7;strokeColor=#8E44AD;fontColor=#512E5F;fontStyle=1;fontSize=13;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="360" height="880" as="geometry" />
        </mxCell>

        <mxCell id="step2_1" value="Phụ huynh vào &lt;b&gt;course-enrollment.html&lt;/b&gt;&#xa;Chọn con &amp;amp; Khóa học mong muốn&#xa;Gửi Đơn Đăng Ký Học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E44AD;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane2">
          <mxGeometry x="65" y="70" width="230" height="55" as="geometry" />
        </mxCell>

        <mxCell id="step2_2" value="Có yêu cầu&#xa;Test Đầu Vào&#xa;không?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;fontSize=11;fontColor=#7D6608;shadow=1;" vertex="1" parent="lane2">
          <mxGeometry x="120" y="150" width="120" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step2_test" value="Giáo viên đánh giá năng khiếu&#xa;&lt;b&gt;Placement Test&lt;/b&gt;&#xa;Đề xuất trình độ &amp;amp; khóa học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E44AD;fontSize=11;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane2">
          <mxGeometry x="20" y="240" width="150" height="55" as="geometry" />
        </mxCell>

        <mxCell id="step2_ready" value="Đơn chuyển sang trạng thái:&#xa;&lt;b style=&quot;color:#8E44AD;&quot;&gt;READY_FOR_ASSIGNMENT&lt;/b&gt;&#xa;(Sẵn sàng chờ giáo vụ xếp lớp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E44AD;fontSize=11;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane2">
          <mxGeometry x="190" y="240" width="155" height="55" as="geometry" />
        </mxCell>

        <mxCell id="step2_3" value="Giáo vụ mở tab &quot;Chờ xử lý&quot;&#xa;Bấm nút &lt;b&gt;&quot;Duyệt Xếp Lớp&quot;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E44AD;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane2">
          <mxGeometry x="65" y="325" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="step2_4" value="&lt;b style=&quot;color:#C0392B;&quot;&gt;★ CHỌN LỚP HỌC CHO HỌC SINH&lt;/b&gt;&#xa;Dropdown &lt;i&gt;assignedClassSelect&lt;/i&gt;&#xa;Chọn lớp đang mở còn chỗ trống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;fontSize=12;fontColor=#2C3E50;shadow=1;strokeWidth=2;" vertex="1" parent="lane2">
          <mxGeometry x="65" y="400" width="230" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step2_5" value="Gửi API Backend:&#xa;&lt;b&gt;POST /api/course-enrollment/requests/{id}/decision&lt;/b&gt;&#xa;• Tạo bản ghi &lt;b&gt;Enrollment&lt;/b&gt; (PENDING_PAYMENT)&#xa;• Tự sinh &lt;b&gt;Invoice&lt;/b&gt; học phí (UNPAID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#27AE60;fontSize=12;fontColor=#1E8449;shadow=1;" vertex="1" parent="lane2">
          <mxGeometry x="40" y="495" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="step2_6" value="&lt;b style=&quot;color:#D35400;&quot;&gt;QUY TRÌNH TẠI QUẦY (GIỮ CHỖ)&lt;/b&gt;&#xa;Thu ngân vào &lt;b&gt;tuition-payment.html&lt;/b&gt;&#xa;Bấm &quot;Đăng Ký Học Viên Mới&quot;&#xa;Chọn thẳng Học Sinh + Lớp Học&#xa;&lt;i&gt;(Sinh luôn Enrollment &amp;amp; Invoice)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#F39C12;fontSize=11;fontColor=#7D6608;shadow=1;" vertex="1" parent="lane2">
          <mxGeometry x="50" y="600" width="260" height="75" as="geometry" />
        </mxCell>

        <mxCell id="step2_7" value="&lt;b style=&quot;color:#2980B9;&quot;&gt;➡ CHUYỂN SANG ĐÓNG HỌC PHÍ&lt;/b&gt;&#xa;Học sinh đã được gán vào lớp,&#xa;nhưng cần nộp phí để chính thức kích hoạt!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;fontSize=12;fontColor=#1B4F72;shadow=1;" vertex="1" parent="lane2">
          <mxGeometry x="65" y="700" width="230" height="65" as="geometry" />
        </mxCell>

