        <!-- ================= SWIMLANE 3: THANH TOÁN & KÍCH HOẠT VÀO LỚP ================= -->
        <mxCell id="lane3" value="PHÂN HỆ 3: THANH TOÁN &amp;amp; KÍCH HOẠT VÀO LỚP&#xa;(Role: PHỤ HUYNH, THU NGÂN, CỔNG PAYOS)" style="swimlane;startSize=50;fillColor=#FEF9E7;strokeColor=#F39C12;fontColor=#7D6608;fontStyle=1;fontSize=13;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="110" width="360" height="880" as="geometry" />
        </mxCell>

        <mxCell id="step3_1" value="Hóa đơn &lt;b&gt;Invoice&lt;/b&gt; hiển thị:&#xa;• Mã HĐ: INV-2026-xxxx&#xa;• Tiền học phí: 3.600.000 đ&#xa;• Trạng thái: &lt;b style=&quot;color:#C0392B;&quot;&gt;UNPAID&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F39C12;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane3">
          <mxGeometry x="65" y="70" width="230" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step3_2" value="Chọn hình thức&#xa;Thanh toán?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#F39C12;fontSize=11;fontColor=#7D6608;shadow=1;" vertex="1" parent="lane3">
          <mxGeometry x="110" y="160" width="140" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step3_qr" value="&lt;b&gt;Quét mã VietQR PayOS&lt;/b&gt;&#xa;Phụ huynh quét mã trên app ngân hàng&#xa;Webhook tự gửi xác nhận" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#1ABC9C;fontSize=11;fontColor=#117A65;shadow=1;" vertex="1" parent="lane3">
          <mxGeometry x="15" y="250" width="150" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step3_cash" value="&lt;b&gt;Nộp Tiền Mặt Tại Quầy&lt;/b&gt;&#xa;Thu ngân nhận tiền&#xa;Bấm nút &quot;Thu Tiền&quot; trên web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F39C12;fontSize=11;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane3">
          <mxGeometry x="195" y="250" width="150" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step3_3" value="Backend Xử Lý Giao Dịch:&#xa;• Cập nhật &lt;b&gt;Invoice -&amp;gt; PAID&lt;/b&gt;&#xa;• Tạo bản ghi &lt;b&gt;Payment&lt;/b&gt; (SUCCESS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#27AE60;fontSize=12;fontColor=#1E8449;shadow=1;" vertex="1" parent="lane3">
          <mxGeometry x="65" y="340" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step3_4" value="&lt;b style=&quot;color:#C0392B;font-size:13px;&quot;&gt;★ KÍCH HOẠT VÀO LỚP CHÍNH THỨC&lt;/b&gt;&#xa;&lt;b style=&quot;color:#27AE60;&quot;&gt;1. Enrollment: ENROLLED&lt;/b&gt;&#xa;&lt;b style=&quot;color:#2980B9;&quot;&gt;2. classes.currentStudents = current + 1&lt;/b&gt;&#xa;(Sĩ số lớp chính thức tăng thêm 1 học viên)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;fontSize=12;fontColor=#2C3E50;shadow=1;strokeWidth=2;" vertex="1" parent="lane3">
          <mxGeometry x="40" y="430" width="280" height="85" as="geometry" />
        </mxCell>

        <mxCell id="step3_5" value="&lt;b style=&quot;color:#27AE60;&quot;&gt;✔ HOÀN TẤT THÊM HỌC SINH&lt;/b&gt;&#xa;Học sinh có tên chính thức&#xa;trong danh sách lớp học!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#1ABC9C;fontSize=12;fontColor=#117A65;shadow=1;strokeWidth=2;" vertex="1" parent="lane3">
          <mxGeometry x="65" y="545" width="230" height="65" as="geometry" />
        </mxCell>

