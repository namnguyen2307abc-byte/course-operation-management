        <!-- ================= SWIMLANE 4: ĐIỂM DANH & VẬN HÀNH ================= -->
        <mxCell id="lane4" value="PHÂN HỆ 4: ĐIỂM DANH &amp;amp; VẬN HÀNH BUỔI HỌC&#xa;(Role: GIÁO VIÊN PHỤ TRÁCH LỚP)" style="swimlane;startSize=50;fillColor=#E8F8F5;strokeColor=#27AE60;fontColor=#1E8449;fontStyle=1;fontSize=13;rounded=1;arcSize=6;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1195" y="110" width="345" height="880" as="geometry" />
        </mxCell>

        <mxCell id="step4_1" value="Đến ngày diễn ra buổi học (&lt;b&gt;Lesson&lt;/b&gt;)&#xa;theo Thời Khóa Biểu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane4">
          <mxGeometry x="55" y="70" width="235" height="55" as="geometry" />
        </mxCell>

        <mxCell id="step4_2" value="Giáo viên đăng nhập hệ thống&#xa;Mở trang &lt;b&gt;weekly-schedule.html&lt;/b&gt;&#xa;Nhấp vào ca học của lớp mình" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane4">
          <mxGeometry x="55" y="160" width="235" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step4_3" value="Backend kiểm tra quyền:&#xa;&lt;b&gt;currentUser.id == lesson.teacher.id&lt;/b&gt;&#xa;Chỉ đúng giáo viên phụ trách mới được điểm danh!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;fontSize=11;fontColor=#C0392B;shadow=1;" vertex="1" parent="lane4">
          <mxGeometry x="45" y="255" width="255" height="60" as="geometry" />
        </mxCell>

        <mxCell id="step4_4" value="API tự động tải danh sách:&#xa;&lt;b&gt;GET /api/schedule/lessons/{id}/attendance&lt;/b&gt;&#xa;Toàn bộ học viên có &lt;b&gt;ENROLLED&lt;/b&gt;&#xa;xuất hiện trên Bảng Điểm Danh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#27AE60;fontSize=12;fontColor=#1E8449;shadow=1;" vertex="1" parent="lane4">
          <mxGeometry x="45" y="345" width="255" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step4_5" value="Giáo viên đánh dấu trạng thái:&#xa;• Có mặt (PRESENT)&#xa;• Vắng mặt (ABSENT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;fontSize=12;fontColor=#2C3E50;shadow=1;" vertex="1" parent="lane4">
          <mxGeometry x="55" y="445" width="235" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step4_6" value="Bấm &quot;Lưu Điểm Danh&quot;&#xa;&lt;b&gt;POST /api/schedule/lessons/{id}/attendance&lt;/b&gt;&#xa;Lưu vào bảng &lt;b&gt;attendances&lt;/b&gt;&#xa;Lesson chuyển sang &lt;b&gt;COMPLETED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#27AE60;fontSize=12;fontColor=#1E8449;shadow=1;" vertex="1" parent="lane4">
          <mxGeometry x="45" y="540" width="255" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step4_7" value="&lt;b style=&quot;color:#27AE60;&quot;&gt;✔ KẾT THÚC BUỔI HỌC THÀNH CÔNG&lt;/b&gt;&#xa;Dữ liệu chuyên cần được lưu lại.&#xa;Học sinh có thể xem lại kết quả điểm danh&#xa;trên hệ thống!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#1ABC9C;fontSize=12;fontColor=#117A65;shadow=1;strokeWidth=2;" vertex="1" parent="lane4">
          <mxGeometry x="45" y="640" width="255" height="75" as="geometry" />
        </mxCell>

        <!-- Edges Lane 4 -->
        <mxCell id="e4_1" edge="1" parent="lane4" source="step4_1" target="step4_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#27AE60;strokeWidth=2;">
